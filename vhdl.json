{
  "UVVM VUnit Testbench Template": {
    "prefix": "uvvm_tb",
    "body": [
      "library ieee;",
      "use ieee.std_logic_1164.all;",
      "",
      "library vunit_lib;",
      "context vunit_lib.vunit_context;",
      "",
      "library uvvm_util;",
      "context uvvm_util.uvvm_util_context;",
      "",
      "library uvvm_vvc_framework;",
      "use uvvm_vvc_framework.ti_vvc_framework_support_pkg.all;",
      "",
      "library bitvis_vip_clock_generator;",
      "context bitvis_vip_clock_generator.vvc_context;",
      "------------------------------------------------------------------------",
      "entity ${1:module}_tb is",
      "  generic (runner_cfg : string);",
      "end entity;",
      "------------------------------------------------------------------------",
      "architecture sim of ${1:module}_tb is",
      "",
      "  constant C_LOG_FILE : string := string'(\"${1:module}_tb_log.txt\");",
      "",
      "begin",
      "",
      "  ------------------------------------------------------------------------",
      "  -- Test Harness Instantiation",
      "  ------------------------------------------------------------------------",
      "  TEST_HARNESS : entity work.${1:module}_th;",
      "",
      "  SEQUENCER_PROC : process",
      "  begin",
      "    ------------------------------------------------------------------------",
      "    -- VUnit setup",
      "    ------------------------------------------------------------------------",
      "    test_runner_setup(runner, runner_cfg);",
      "",
      "    ------------------------------------------------------------------------",
      "    -- UVVM setup",
      "    ------------------------------------------------------------------------",
      "    set_log_file_name(C_LOG_FILE);",
      "    await_uvvm_initialization(VOID);",
      "",
      "    ------------------------------------------------------------------------",
      "    -- Start Clock",
      "    ------------------------------------------------------------------------",
      "    log(ID_LOG_HDR, \"Start Clock Generator\");",
      "    start_clock(CLOCK_GENERATOR_VVCT, 0, \"Start clock generator\");",
      "",
      "    if run(\"test_case_1\") then",
      "",
      "    elsif run(\"test_case_2\") then",
      "",
      "    end if;",
      "",
      "    ------------------------------------------------------------------------",
      "    -- UVVM cleanup",
      "    ------------------------------------------------------------------------",
      "    report_alert_counters(FINAL);",
      "",
      "    ------------------------------------------------------------------------",
      "    -- VUnit cleanup",
      "    ------------------------------------------------------------------------",
      "    test_runner_cleanup(runner);",
      "",
      "  end process;",
      "",
      "end architecture;"
    ],
    "description": "UVVM + VUnit VHDL testbench template"
  },

  "UVVM Test Harness Template": {
    "prefix": "uvvm_th",
    "body": [
      "library ieee;",
      "use ieee.std_logic_1164.all;",
      "",
      "library uvvm_vvc_framework;",
      "library bitvis_vip_clock_generator;",
      "------------------------------------------------------------------------",
      "entity ${1:module}_th is",
      "end entity;",
      "------------------------------------------------------------------------",
      "architecture sim of ${1:module}_th is",
      "",
      "  constant C_CLK_PERIOD       : time    := 10 ns;",
      "  constant C_SIM_RESET_CYCLES : natural := 10;",
      "",
      "  signal clk     : std_logic;",
      "  signal reset_n : std_logic;",
      "",
      "begin",
      "",
      "  ------------------------------------------------------------------------",
      "  -- UVVM Engine Instantiation",
      "  ------------------------------------------------------------------------",
      "  UVVM_ENGINE : entity uvvm_vvc_framework.ti_uvvm_engine(func);",
      "",
      "  ------------------------------------------------------------------------",
      "  -- Clock Generator Instantiation",
      "  ------------------------------------------------------------------------",
      "  CLOCK_GEN : entity bitvis_vip_clock_generator.clock_generator_vvc",
      "    generic map(",
      "      GC_CLOCK_PERIOD    => C_CLK_PERIOD,",
      "      GC_CLOCK_HIGH_TIME => C_CLK_PERIOD / 2,",
      "      GC_INSTANCE_IDX    => 0",
      "    )",
      "    port map",
      "    (",
      "      clk => clk",
      "    );",
      "",
      "  -- Release reset",
      "  reset_n <= '0', '1' after C_CLK_PERIOD * C_SIM_RESET_CYCLES;",
      "",
      "  ------------------------------------------------------------------------",
      "  -- DUT Instantiation",
      "  ------------------------------------------------------------------------",
      "  DUT : entity work.${1:module}",
      "    port map(",
      "      clk     => clk,",
      "      reset_n => reset_n",
      "    );",
      "",
      "",
      "end architecture;"
    ],
    "description": "UVVM VHDL test harness template"
  }
}